REDFISH_BASE_URL=https://bmc.example.com
REDFISH_USERNAME=readonly-observer
REDFISH_PASSWORD=replace-locally
RACKLENS_LLM_BASE_URL=http://localhost:11434/v1
RACKLENS_LLM_API_KEY=ollama
RACKLENS_LLM_MODEL=qwen3:4b

# Storage: omit CLICKHOUSE_URL to use local SQLite.
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=racklens-local
CLICKHOUSE_DATABASE=racklens

# Optional: push the edge collector into the hosted RackLens ingestion API.
RACKLENS_HOSTED_INGEST_URL=https://racklens-ai.siva-babu.chatgpt.site
RACKLENS_INGEST_TOKEN=replace-with-a-long-random-secret

# Optional hybrid AI tracing: application → OTel Collector → ClickHouse/LangSmith.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
LANGSMITH_TRACING=true
LANGSMITH_OTEL_ENABLED=true
LANGSMITH_API_KEY=replace-locally
LANGSMITH_PROJECT=racklens-reliability-prod
