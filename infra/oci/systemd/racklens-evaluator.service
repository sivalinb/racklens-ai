[Unit]
Description=Run RackLens evidence and safety evaluation
Requires=docker.service
After=docker.service racklens-stack.service

[Service]
Type=oneshot
WorkingDirectory=/opt/racklens
ExecStartPre=/usr/bin/docker compose --env-file /etc/racklens/racklens.env -f infra/docker-compose.yml -f infra/docker-compose.oci.yml --profile evaluation run --rm --no-deps --user 0:0 --entrypoint chown evaluator 65532:65532 /var/lib/racklens/evaluations
ExecStart=/usr/bin/docker compose --env-file /etc/racklens/racklens.env -f infra/docker-compose.yml -f infra/docker-compose.oci.yml --profile evaluation run --rm evaluator
TimeoutStartSec=600
